# One settings file for every bot. Copy to .env for local runs (never commit .env).
# On GitHub the same names go in Settings > Secrets and variables > Actions
# (secrets for logins / ids, variables for the tuning values at the bottom).

# ---- Shared ------------------------------------------------------------------
OMSGURU_EMAIL=
OMSGURU_PASSWORD=
# only if 2-step login is on for the account
OMSGURU_OTP=
# Telegram (@bindal_exports_bot); comma-separate several chat ids
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Google service account (ajio-tat-bot@storied-port-441507-k7.iam.gserviceaccount.com):
# local = key file path, GitHub = the whole key JSON in GOOGLE_SERVICE_ACCOUNT_JSON
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
# Drive relay (scripts/drive_relay.gs, an Apps Script web app run as the Drive owner): creates new
# Drive files for the bots, as a service account cannot (no storage quota)
DRIVE_RELAY_URL=
DRIVE_RELAY_TOKEN=
# shared with the AJIO SPF courier check
SHADOWFAX_TOKEN=
RUN_MODE=local
# Dashboard: the bots push their numbers to the Telegram worker's /api/push (optional)
DASHBOARD_URL=
DASHBOARD_TOKEN=

# ---- Daily sale report (run.py sale) ------------------------------------------
# DAILY SALE REPORT BINDAL/SALE REPORT.xlsx
SALE_DRIVE_FILE_ID=
# local workbook for --no-drive runs
SALE_XLSX_PATH=
FLIPKART_EMAIL=
FLIPKART_PASSWORD=
# Drive folder BINDAL EXPORTS/RETURN ANALYSIS (monthly + yearly return analysis)
RETURN_DRIVE_FOLDER_ID=
# key that encrypts the GitHub Actions run output (scripts/ci_run.sh, scripts/run_output.py)
ARTIFACT_KEY=
# Drive folder where the Myntra Seller_Orders_Report CSV is dropped by hand
SJIT_DRIVE_FOLDER_ID=
# Myntra partner portal login saved by scripts/myntra_session.py (SJIT report fetched by the bot):
# GitHub = the JSON in MYNTRA_SESSION_JSON, local = the file (default myntra_session.json here)
MYNTRA_SESSION_JSON=
MYNTRA_SESSION_FILE=

# ---- Myntra VMS report (run.py vms) -------------------------------------------
VMS_USERNAME=
VMS_PASSWORD=
# VMS/MYNTRA ORDER ID WISE VMS.xlsx
VMS_DRIVE_FILE_ID=
VMS_XLSX_PATH=

# ---- AJIO dispatch TAT (run.py ajio-tat) --------------------------------------
TAT_DRIVE_FILE_ID=
# Drive folder AJIO/Ajio Daily Order Tat Check Working: the master is kept there by name (wins over TAT_DRIVE_FILE_ID)
TAT_DRIVE_FOLDER_ID=
# optional Google Sheet copy of the master
TAT_GOOGLE_SHEET_ID=
# local master for --no-drive runs (default data/AJIO_TAT_MASTER.xlsx)
TAT_XLSX_PATH=

# ---- AJIO SPF claims (run.py ajio-spf) ----------------------------------------
AJIO_USERNAME=
AJIO_PASSWORD=
SRM_USERNAME=
SRM_PASSWORD=
ERP_USERNAME=
ERP_PASSWORD=
ERP_USER_TOKEN=
GEMINI_API_KEY=
# SPF/AJIO/AJIO MASTER.xlsx
SPF_MASTER_DRIVE_FILE_ID=
SPF_MANUAL_DRIVE_FILE_ID=
SPF_OMS_DRIVE_FILE_ID=
# local test without Drive: the synced files directly
SPF_MASTER_XLSX_PATH=
SPF_MANUAL_XLSX_PATH=
SPF_OMS_XLSX_PATH=
# 1 = nothing is posted to AJIO (default). Only 0 / false / no / off posts tickets and replies.
SPF_DRY_RUN=1

# ---- Tuning (defaults are fine) ------------------------------------------------
SALE_REPORT_DAYS=2
# SJIT portal report: days requested (cancels of older orders), minutes to wait, warn days before the session expires
SJIT_FETCH_DAYS=30
SJIT_WAIT_MINUTES=20
MYNTRA_SESSION_WARN_DAYS=3
FBF_LOCATIONS=bhi_vas_wh_nl_01nl,frk_bts,gur_san_wh_nl_01nl,malur_bts,ulub_bts
MYNTRA_CHANNELS=45111:TLPL,47460:MMRJ,49234:BOAT
SLA_LOOKBACK_DAYS=10
VMS_REPORT_DAYS=1
AJIO_CHANNEL_IDS=57285,34958
TAT_LOOKBACK_DAYS=1
TRACK_DAYS=15
OMSGURU_WORKERS=6
TRACK_WORKERS=8
POB_ID=DV00348890
MAX_RAISE_PER_RUN=40
MAX_REPLIES_PER_RUN=30
# Myntra SPF: older order reports for returns without ORDER AMOUNT (new requests per account per run, look-back days)
MYNTRA_SPF_OLD_ORDERS_NEW=1
MYNTRA_SPF_OLD_WAIT_MINUTES=10
MYNTRA_SPF_ORDER_LOOKBACK=45
