{
  "manifest_version": 3,
  "name": "Bindal Myntra Session",
  "version": "1.0.0",
  "description": "Sends the Myntra partner portal login to the Bindal sale bot whenever it changes.",
  "incognito": "spanning",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": ["https://*.myntrainfo.com/*", "https://*.workers.dev/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Bindal Myntra Session", "default_popup": "popup.html" }
}
